# Application
NODE_ENV=development              # development | production
APP_ENV=local                     # local | dev | prod
PORT=5000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000 # Comma-separated allowed browser origins
COOKIE_SECRET=replace-with-a-long-random-secret
JWT_BEARER_SECRET=replace-with-a-long-random-secret
JWT_TTL=31536000                   # Token lifetime in seconds
AUTH_SERVER_AUDIENCE=              # Optional JWT audience

# PostgreSQL (TypeORM)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=labify_db

# Redis (Bull connection uses REDIS_URL)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# SMTP settings (required by the application environment schema)
MAILER_HOST=localhost
MAILER_PORT=1025
MAILER_SECURE=false
MAILER_USER=
MAILER_PASSWORD=
MAILER_FROM=Labify <no-reply@localhost>

# Optional logging and application settings
DEBUG_LOG=false
WARN_LOG=true
ERROR_LOG=true
REQ_LOG=true
LOG_FILE=true
BULB_REWARD_INTERVAL_SECOND=604800
BLOCK_QUERY_INTERVAL=10000
LONG_BREAK_THRESHOLD_IN_SECONDS=64800
RTC_PORT_MIN=10000
RTC_PORT_MAX=10100
NETWORK_NAME=mainnet
CHAIN_ID=1
# PRIVATE_KEY=
